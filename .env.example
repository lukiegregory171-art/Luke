# ── Choose your provider ──────────────────────────────────────────────────────
#
#  FREE  → use Groq  (get key at: console.groq.com — sign up, it's free)
#  PAID  → use Claude (get key at: console.anthropic.com)
#
# The app auto-detects which key you've set, or you can force it:
# PROVIDER=groq
# PROVIDER=claude

# Groq API key (FREE — 14,400 requests/day, powered by Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic/Claude API key (paid, best quality)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Personal settings ─────────────────────────────────────────────────────────
USER_NAME=Sir
VOICE_ENABLED=true
VOICE_RATE=160
